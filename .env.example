# 环境变量配置（部署前复制为 .env 并填写真实值）
#
# 以下三项在 docker-compose.yml 中已改为必填（${VAR:?}），留空或删掉 .env 会直接启动失败，
# 而不是悄悄用弱默认值跑起来 —— 这是为了避免公网扫描器用字典口令打穿数据库。
# 生成强随机值：
#   openssl rand -base64 24        # 口令
#   openssl rand -hex 32           # JWT 密钥

# MySQL root 口令（同时用于后端连接数据库与健康检查）
MYSQL_ROOT_PASSWORD=

MYSQL_DATABASE=hr_db

# Redis 口令（Redis 端口只绑 127.0.0.1，但口令仍必须设置）
REDIS_PASSWORD=

# JWT 签名密钥，长度 >= 32 字节；轮换后所有已签发令牌失效，用户需重新登录
HR_AUTH_JWT_SECRET=
