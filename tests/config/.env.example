# ========================================
# HR 系统自动化测试 - 环境配置模板
# 复制为 .env.dev / .env.test / .env.prod 后填写真实值
# .env.* 已被 .gitignore 忽略，本模板不含任何真实密钥
# ========================================

# 服务基础地址
HR_BASE_URL=http://localhost:8080

# 管理员账号（非生产环境账号；生产凭证不写入本文件）
HR_ADMIN_USER=
HR_ADMIN_PWD=

# 日志级别: DEBUG / INFO / WARNING / ERROR
HR_LOG_LEVEL=INFO

# JWT 密钥（对应后端 hr.auth.jwt-secret）
# 仅 TC-AUTH-014 在本地自签过期 token 时使用；留空则该用例按条件跳过
HR_JWT_SECRET=
